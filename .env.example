# Getnet Multi-Agent Support System — configuration template.
# Copy to .env and fill MINIMAX_API_KEY (and WEB_SEARCH_API_KEY). Every variable has a safe default;
# values below are the defaults used by docker-compose.yml. Never commit .env.

# --- Application -----------------------------------------------------------------------------
APP_ENV=development                 # development | test | production (production refuses demo auth, fake LLM, debug endpoints)
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR
APP_VERSION=1.0.0

# --- Identity --------------------------------------------------------------------------------
AUTH_MODE=jwt                       # jwt | demo (demo: body user_id is the identity; refused in production)
JWT_ISSUER=https://dev-idp.local    # expected `iss`
JWT_AUDIENCE=getnet-support-api     # expected `aud`
JWT_JWKS_URL=file:///keys/jwks.json # https OIDC JWKS in production; dev keys come from `make keys`
JWT_LEEWAY_SECONDS=30               # clock-skew tolerance

# --- LLM: MiniMax-M3 is the only reasoning model --------------------------------------------
LLM_PROVIDER=minimax                # minimax | fake (fake = deterministic test double, refused in production)
MINIMAX_API_KEY=                    # https://platform.minimax.io — required for the real assistant
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_MODEL=MiniMax-M3
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2                   # retries only 408/409/429/5xx/timeouts, with jittered backoff
LLM_PRICE_INPUT_PER_MTOK=0.30       # USD per 1M input tokens (MiniMax-M3 pay-as-you-go, <=512k context)
LLM_PRICE_OUTPUT_PER_MTOK=1.20      # USD per 1M output tokens
MAX_TOKENS_PER_REQUEST=40000        # hard per-request token budget enforced by code

# --- Datastores ------------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://getnet:getnet-dev-only@postgres:5432/getnet
POSTGRES_PASSWORD=getnet-dev-only   # local stack only; use a secrets manager in production
QDRANT_URL=http://qdrant:6333
REDIS_URL=redis://redis:6379/0

# --- External web search ---------------------------------------------------------------------
WEB_SEARCH_PROVIDER=tavily          # tavily | disabled
WEB_SEARCH_API_KEY=                 # https://tavily.com — weather/exchange-rate questions degrade honestly without it

# --- Retrieval (local models in the `models` volume; see ADR 006 for the benchmark) ----------
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2   # 384-d, cosine
SPARSE_MODEL=Qdrant/bm25                                                      # BM25 with Portuguese stemming
RERANKER_MODEL=jinaai/jina-reranker-v2-base-multilingual
RAG_TOP_K=15                        # fused (RRF) candidates
RAG_RERANK_TOP_K=8                  # candidates sent to the cross-encoder
RAG_CONTEXT_TOP_K=5                 # evidence passages given to the generator
RAG_MIN_SCORE=0.0                   # RRF score floor (rank-based; kept at 0, see calibration.md)
RAG_RERANK_MIN_SCORE=-0.8           # calibrated on the golden set (`make calibrate`)

# --- Decision model / supervisor -------------------------------------------------------------
ESCALATION_CONFIDENCE_THRESHOLD=0.55
ESCALATION_PENALTIES_FILE=config/escalation_penalties.yaml
TROUBLESHOOTING_MAX_ATTEMPTS=3      # escalate on the Nth failed troubleshooting attempt
SUPERVISOR_MAX_STEPS=3              # steps the supervisor may add per request

# --- Conversation memory ---------------------------------------------------------------------
MEMORY_WINDOW_TURNS=8               # turns given to the agents (redacted, untrusted)
MEMORY_TOKEN_BUDGET=1800            # older turns above this are summarized by MiniMax-M3
CONVERSATION_TTL_DAYS=30            # retention; purged by the worker / `make purge-expired`

# --- Human in the loop -----------------------------------------------------------------------
HITL_SLA_MINUTES=30                 # base SLA (urgent = half, normal = 4x)
OPERATOR_WEBHOOK_URL=               # Teams/Slack-compatible webhook; empty = structured log sink

# --- API protection --------------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=30            # per subject (Redis sliding window, shared across replicas)
ENABLE_DEBUG_ENDPOINTS=true         # /v1/debug/traces and /v1/dev/token; forced off in production
CORS_ALLOW_ORIGINS=                 # comma-separated; empty = deny all cross-origin requests

# --- Observability ---------------------------------------------------------------------------
OTEL_ENABLED=false                  # true with `make observability-up`
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
